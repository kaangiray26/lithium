#!/usr/bin/env bash
#
# lithium - manage Wine prefixes and launch Windows games through the
# Lithium DXVK/MoltenVK stack on Apple Silicon.
#
# This currently points straight at the dev build trees under build/ rather
# than a packaged dist/ (see docs/plan.md phase 5/6) -- adjust the paths
# below if you relocate things.

set -euo pipefail

LITHIUM_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

WINE_BUILD_DIR="$LITHIUM_ROOT/build/wine"
WINE_BIN="$WINE_BUILD_DIR/loader/wine"

DXVK_BUILD_DIR="$LITHIUM_ROOT/build/dxvk/src"
# subdir:dllname pairs, copied into the prefix's system32 on prefix-create
DXVK_DLLS=(
  "d3d8:d3d8.dll"
  "d3d9:d3d9.dll"
  "d3d10:d3d10core.dll"
  "d3d11:d3d11.dll"
  "dxgi:dxgi.dll"
)

MOLTENVK_DYLIB_DIR="${LITHIUM_MOLTENVK_DIR:-$HOME/external/MoltenVK/Package/Release/MoltenVK/dynamic/dylib/macOS}"

PREFIXES_DIR="$LITHIUM_ROOT/prefixes"

# Extra x86_64 Homebrew tool/lib locations Wine's build and runtime need.
# See docs memory: bison (macOS ships a too-old one), mingw-w64, and the
# x86_64 Homebrew prefix at /usr/local for runtime dylibs.
EXTRA_PATH="/opt/homebrew/opt/bison/bin:/opt/homebrew/bin:/usr/local/bin"

# Wine can't dlopen these x86_64 Homebrew dylibs via the default fallback
# path in this environment (see docs memory) -- point it at them explicitly.
DYLD_FALLBACK_LIBRARY_PATH_VALUE="/usr/local/lib:/usr/local/opt/freetype/lib:/usr/local/opt/gnutls/lib:$MOLTENVK_DYLIB_DIR"

# Use DXVK's native DLLs instead of Wine's built-in Direct3D implementations.
WINEDLLOVERRIDES_VALUE="d3d8,d3d9,d3d10core,d3d11,dxgi=n"

# winegstreamer (video/audio codec support) needs the actual GStreamer
# plugins findable at runtime, not just its shared libs (already covered
# by DYLD_FALLBACK_LIBRARY_PATH_VALUE above).
GST_PLUGIN_PATH_VALUE="/usr/local/lib/gstreamer-1.0"

usage() {
  cat <<'EOF'
Usage: lithium <command> [args...]

Commands:
  doctor                       Check that the toolchain/build is in place
  prefix-create <name>         Create and initialize a new Wine prefix
  prefix-kill <name>           Cleanly shut down a prefix's Wine session
  run <name> <exe> [args...]   Run a Windows executable inside a prefix
  install <name> <installer>   Run a Windows installer inside a prefix
                                (alias for 'run')

Prefixes live under: prefixes/<name>
EOF
}

require_wine_build() {
  if [[ ! -x "$WINE_BIN" ]]; then
    echo "error: wine binary not found at $WINE_BIN (build it first)" >&2
    exit 1
  fi
}

prefix_path() {
  echo "$PREFIXES_DIR/$1"
}

# Run a command against a prefix with all the env plumbing this stack needs.
# Set LITHIUM_EXTRA_DLL_OVERRIDES before calling to append extra overrides
# (e.g. disabling mscoree during first boot to skip the Mono nag dialog).
lithium_wine_exec() {
  local prefix_dir="$1"
  shift
  local overrides="$WINEDLLOVERRIDES_VALUE"
  [[ -n "${LITHIUM_EXTRA_DLL_OVERRIDES:-}" ]] && overrides+=",$LITHIUM_EXTRA_DLL_OVERRIDES"
  arch -x86_64 env \
    PATH="$EXTRA_PATH:$PATH" \
    WINEPREFIX="$prefix_dir" \
    DYLD_FALLBACK_LIBRARY_PATH="$DYLD_FALLBACK_LIBRARY_PATH_VALUE" \
    GST_PLUGIN_PATH="$GST_PLUGIN_PATH_VALUE" \
    WINEDLLOVERRIDES="$overrides" \
    "$WINE_BIN" "$@"
}

cmd_doctor() {
  local ok=1

  echo "Lithium root:        $LITHIUM_ROOT"

  if [[ -x "$WINE_BIN" ]]; then
    echo "Wine binary:          OK ($WINE_BIN)"
  else
    echo "Wine binary:          MISSING ($WINE_BIN)"
    ok=0
  fi

  for entry in "${DXVK_DLLS[@]}"; do
    local dll="${entry#*:}"
    local sub="${entry%%:*}"
    local path="$DXVK_BUILD_DIR/$sub/$dll"
    if [[ -f "$path" ]]; then
      echo "DXVK $dll:$(printf '%*s' $((14 - ${#dll})) '') OK"
    else
      echo "DXVK $dll:$(printf '%*s' $((14 - ${#dll})) '') MISSING ($path)"
      ok=0
    fi
  done

  if [[ -f "$MOLTENVK_DYLIB_DIR/libMoltenVK.dylib" ]]; then
    echo "MoltenVK dylib:       OK ($MOLTENVK_DYLIB_DIR/libMoltenVK.dylib)"
  else
    echo "MoltenVK dylib:       MISSING ($MOLTENVK_DYLIB_DIR/libMoltenVK.dylib)"
    ok=0
  fi

  if [[ "$ok" -eq 1 ]]; then
    echo "Status: ready"
  else
    echo "Status: incomplete -- see docs/plan.md"
    exit 1
  fi
}

cmd_prefix_create() {
  local name="${1:?usage: lithium prefix-create <name>}"
  require_wine_build

  local prefix_dir
  prefix_dir="$(prefix_path "$name")"

  if [[ -e "$prefix_dir" ]]; then
    echo "error: prefix already exists at $prefix_dir" >&2
    exit 1
  fi

  mkdir -p "$prefix_dir"
  echo "Creating prefix '$name' at $prefix_dir (first boot is slow under Rosetta, be patient)..."
  # Disable mscoree during first boot only, to skip the "Wine Mono Installer"
  # nag dialog -- it's unrelated to whether the game itself needs .NET.
  LITHIUM_EXTRA_DLL_OVERRIDES="mscoree=" lithium_wine_exec "$prefix_dir" wineboot --init

  echo "Installing DXVK..."
  local system32="$prefix_dir/drive_c/windows/system32"
  mkdir -p "$system32"
  for entry in "${DXVK_DLLS[@]}"; do
    local sub="${entry%%:*}"
    local dll="${entry#*:}"
    cp "$DXVK_BUILD_DIR/$sub/$dll" "$system32/"
  done

  echo "Prefix '$name' ready."
}

cmd_prefix_kill() {
  local name="${1:?usage: lithium prefix-kill <name>}"
  require_wine_build

  local prefix_dir
  prefix_dir="$(prefix_path "$name")"
  if [[ ! -d "$prefix_dir" ]]; then
    echo "error: no such prefix: $name" >&2
    exit 1
  fi

  lithium_wine_exec "$prefix_dir" wineboot -k
}

cmd_run() {
  local name="${1:?usage: lithium run <name> <exe> [args...]}"
  local exe="${2:?usage: lithium run <name> <exe> [args...]}"
  shift 2
  require_wine_build

  local prefix_dir
  prefix_dir="$(prefix_path "$name")"
  if [[ ! -d "$prefix_dir" ]]; then
    echo "error: no such prefix: $name (run 'lithium prefix-create $name' first)" >&2
    exit 1
  fi

  lithium_wine_exec "$prefix_dir" "$exe" "$@"
}

main() {
  local command="${1:-}"
  [[ $# -gt 0 ]] && shift || true

  case "$command" in
    doctor)         cmd_doctor "$@" ;;
    prefix-create)  cmd_prefix_create "$@" ;;
    prefix-kill)    cmd_prefix_kill "$@" ;;
    run)            cmd_run "$@" ;;
    install)        cmd_run "$@" ;;
    -h|--help|help|"") usage ;;
    *)
      echo "error: unknown command '$command'" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
